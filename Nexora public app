                    "tourist",
                    "tourism",
                    "museum",
                    "monument",
                    "park"
                ],
                "Tourist Places"
            ),
            (
                ["market", "shop"],
                "Markets"
            ),
            (
                ["weather", "temperature"],
                "Weather"
            )
        ]

        for words, category in mappings:

            if any(
                word in text
                for word in words
            ):

                if category == "Weather":

                    self.go("weather")

                else:

                    self.open_category(
                        category
                    )

                return

        self.manager.current = "places"

        screen = self.manager.get_screen(
            "places"
        )

        Clock.schedule_once(
            lambda dt:
            screen.search_custom(
                instance.text.strip()
            ),
            0.15
        )


