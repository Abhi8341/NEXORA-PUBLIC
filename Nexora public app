    def build(self):

        self.root_layout.clear_widgets()

        c = C()

        settings = load_notifications()

        self.root_layout.add_widget(
            Label(
                text="🔔 Notifications",
                font_size=27,
                bold=True,
                color=c["text"],
                size_hint_y=None,
                height=dp(50)
            )
        )

        scroll = ScrollView()

        content = BoxLayout(
            orientation="vertical",
            spacing=dp(7),
            size_hint_y=None
        )

        content.bind(
            minimum_height=
            content.setter("height")
        )

        self.controls = {}

        options = [
            (
                "enabled",
                "🔔 Notifications",
                "Enable or disable NEXORA notifications."
            ),
            (
                "weather",
                "🌦️ Weather",
                "Weather-related notifications."
            ),
            (
                "emergency",
                "🚨 Emergency",
                "Emergency-service information."
            ),
            (
                "transport",
                "🚌 Transport",
                "Bus and taxi related information."
            ),
            (
                "airport",
                "✈️ Airport",
                "Airport-related information."
            ),
            (
                "railway",
                "🚉 Railway",
                "Railway-related information."
            ),
            (
                "tourist",
                "🏛️ Tourist Places",
                "Tourism-related information."
            ),
            (
                "quiet_mode",
                "🔕 Quiet Mode",
                "Temporarily reduce NEXORA notifications."
            )
        ]

        for key, title, description in options:

            row = BoxLayout(
                orientation="vertical",
                size_hint_y=None,
                height=dp(72),
                padding=dp(5)
            )

            top = BoxLayout(
                size_hint_y=None,
                height=dp(35)
            )

            label = Label(
                text=title,
                color=c["text"],
                font_size=13,
                bold=True,
                halign="left"
            )

            button = NButton(
                text=(
                    "ON"
                    if settings.get(key, False)
                    else "OFF"
                ),
                bg=(
                    c["green"]
                    if settings.get(key, False)
                    else c["button"]
                ),
                font=10,
                height=34
            )

            button.size_hint_x = None
            button.width = dp(75)

            button.bind(
                on_release=lambda x,
                k=key:
                self.toggle(k)
            )

            self.controls[key] = button

            top.add_widget(label)
            top.add_widget(button)

            row.add_widget(top)

            row.add_widget(
                Label(
                    text=description,
                    color=c["secondary"],
                    font_size=10,
                    halign="left"
                )
            )

            content.add_widget(row)

        # Time

        time_box = BoxLayout(
            orientation="vertical",
            size_hint_y=None,
            height=dp(90)
        )

        time_box.add_widget(
            Label(
                text="⏰ Preferred Notification Time",
                color=c["text"],
                bold=True,
                font_size=13,
                halign="left",
                size_hint_y=None,
                height=dp(30)
            )
        )

        self.time_input = TextInput(
            text=settings.get(
                "notification_time",
                "08:00"
            ),
            hint_text="HH:MM",
            multiline=False,
            size_hint_y=None,
            height=dp(45),
            padding=[dp(12), dp(11)],
            background_color=c["card"],
            foreground_color=c["text"],
            hint_text_color=c["secondary"]
        )

        time_box.add_widget(
            self.time_input
        )

        content.add_widget(
            time_box
        )

        save = NButton(
            text="💾 SAVE NOTIFICATION SETTINGS",
            bg=c["primary"],
            height=54
        )

        save.bind(
            on_release=lambda x:
            self.save()
        )

        content.add_widget(save)

        test = NButton(
            text="🔔 SEND TEST NOTIFICATION",
            bg=c["orange"],
            height=50
        )

        test.bind(
            on_release=lambda x:
            self.test_notification()
        )

        content.add_widget(test)

        self.message = Label(
            text="",
            color=c["secondary"],
            font_size=11,
            size_hint_y=None,
            height=dp(40)
        )

        content.add_widget(
            self.message
        )

        content.add_widget(
            Widget(
                size_hint_y=None,
                height=dp(20)
            )
        )

        scroll.add_widget(content)

        self.root_layout.add_widget(scroll)

        self.root_layout.add_widget(
            NButton(
                text="← Settings",
                bg=c["card"],
                height=46,
                on_release=lambda x:
                setattr(
                    self.manager,
                    "current",
                    "settings"
                )
            )
        )

    def toggle(self, key):

        settings = load_notifications()

        settings[key] = not settings.get(
            key,
            False
        )

        save_notifications(settings)

        button = self.controls.get(key)

        if button:

            c = C()

            button.text = (
                "ON"
                if settings[key]
                else "OFF"
            )

            button.background_color = (
                c["green"]
                if settings[key]
                else c["button"]
            )

    def save(self):

        settings = load_notifications()

        settings["notification_time"] = (
            self.time_input.text.strip()
        )

        if save_notifications(settings):

            self.message.text = (
                "✅ Notification settings saved."
            )

        else:

            self.message.text = (
                "❌ Could not save settings."
            )

    def test_notification(self):

        settings = load_notifications()

        if not settings["enabled"]:

            self.message.text = (
                "Notifications are currently OFF."
            )

            return

        if settings["quiet_mode"]:

            self.message.text = (
                "Quiet Mode is ON."
            )

            return

        if NOTIFICATION_AVAILABLE:

            try:

                notification.notify(
                    title="NEXORA Public",
                    message=(
                        "This is a test notification "
                        "from NEXORA."
                    ),
                    app_name="NEXORA Public",
                    timeout=5
                )

                self.message.text = (
                    "🔔 Test notification sent."
                )

                return

            except Exception as e:

                print(
                    "Notification error:",
                    e
                )

        self.message.text = (
            "Android notification support "
            "is not available in this Pydroid "
            "environment."
        )


