class NexoraLogo(Widget):

    def __init__(
        self,
        logo_size=70,
        **kwargs
    ):

        super().__init__(**kwargs)

        self.size_hint = (
            None,
            None
        )

        self.size = (
            dp(logo_size),
            dp(logo_size)
        )

        with self.canvas:

            Color(
                0.10,
                0.40,
                1,
                1
            )

            self.outer = Ellipse(
                pos=self.pos,
                size=self.size
            )

            Color(
                1,
                1,
                1,
                1
            )

            self.inner = Ellipse(
                pos=(
                    self.x + dp(13),
                    self.y + dp(13)
                ),
                size=(
                    dp(logo_size - 26),
                    dp(logo_size - 26)
                )
            )

        self.bind(
            pos=self.update,
            size=self.update
        )

    def update(self, *args):

        self.outer.pos = self.pos
        self.outer.size = self.size

        self.inner.pos = (
            self.x + dp(13),
            self.y + dp(13)
        )

        self.inner.size = (
            self.width - dp(26),
            self.height - dp(26)
        )


