def send_notification(
    title,
    message
):

    if not NOTIFICATION_AVAILABLE:
        return False

    try:

        notification.notify(
            title=title,
            message=message,
            app_name="NEXORA Public",
            timeout=5
        )

        return True

    except Exception as e:

        print(
            "Notification error:",
            e
        )

        return False


