    def perform_search(self, instance):

        text = (
            instance.text
            .lower()
            .strip()
        )

        if not text:
            return

        mappings = [
            (
                ["hospital", "clinic", "medical"],
                "Hospitals"
            ),
            (
                ["police"],
                "Police"
            ),
            (
                ["fire"],
                "Fire Stations"
