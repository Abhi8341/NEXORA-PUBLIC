class NexoraPublicApp(App):

    def build(self):

        Window.clearcolor = C()["bg"]

        self.manager = ScreenManager(
            transition=FadeTransition(
                duration=0.15
            )
        )

        self.build_screens()

        self.manager.current = "splash"

        Clock.schedule_once(
            self.open_home,
            1.2
        )

        return self.manager

    def build_screens(self):

        self.manager.clear_widgets()

        self.manager.add_widget(
            SplashScreen(
                name="splash"
            )
        )

        self.manager.add_widget(
            HomeScreen(
                name="home"
            )
        )

        self.manager.add_widget(
            WeatherScreen(
                name="weather"
            )
        )

        self.manager.add_widget(
            PlacesScreen(
                name="places"
            )
        )

        self.manager.add_widget(
            FavoritesScreen(
                name="favorites"
            )
        )

        self.manager.add_widget(
            EmergencyScreen(
                name="emergency"
            )
        )

        self.manager.add_widget(
            ProfileScreen(
                name="profile"
            )
        )

        self.manager.add_widget(
            EditProfileScreen(
                name="edit_profile"
            )
        )

        self.manager.add_widget(
            SettingsScreen(
                name="settings"
            )
        )

        self.manager.add_widget(
            NotificationScreen(
                name="notifications"
            )
        )

        self.manager.add_widget(
            InfoScreen(
                name="internet",
                page="internet"
            )
        )

        self.manager.add_widget(
            InfoScreen(
                name="location",
                page="location"
            )
        )

        self.manager.add_widget(
            InfoScreen(
                name="privacy",
                page="privacy"
            )
        )

        self.manager.add_widget(
            InfoScreen(
                name="about",
                page="about"
            )
        )

    def rebuild(self, screen="home"):

        self.build_screens()

        Window.clearcolor = C()["bg"]

        if self.manager.has_screen(screen):

            self.manager.current = screen

        else:

            self.manager.current = "home"

    def open_home(self, dt):

        if self.manager.has_screen("home"):

            self.manager.current = "home"


