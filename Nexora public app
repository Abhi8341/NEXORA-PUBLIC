def load_theme():

    try:

        if os.path.exists(THEME_FILE):

            with open(
                THEME_FILE,
                "r",
                encoding="utf-8"
            ) as f:

                data = json.load(f)

            if data.get("theme") in (
                "dark",
                "light"
            ):

                return data["theme"]

    except Exception:
        pass

    return "dark"


def save_theme(theme):

    try:

        with open(
            THEME_FILE,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                {"theme": theme},
                f
            )

    except Exception:
        pass


CURRENT_THEME = load_theme()


