    def build(self):

        self.root_layout.clear_widgets()

        c = C()

        self.root_layout.add_widget(
            Label(
                text="🌦️ Live Weather",
                font_size=27,
                bold=True,
                color=c["text"],
                size_hint_y=None,
                height=dp(52)
            )
        )

        self.city = TextInput(
            hint_text="Enter city",
            multiline=False,
            size_hint_y=None,
            height=dp(50),
            padding=[
                dp(13),
                dp(12)
            ],
            background_color=c["card"],
            foreground_color=c["text"],
            hint_text_color=c["secondary"]
        )

        self.root_layout.add_widget(
            self.city
        )

        button = NButton(
            text="🌦️ GET LIVE WEATHER",
            bg=c["primary"],
            height=50
        )

        button.bind(
            on_release=self.get_weather
        )

        self.root_layout.add_widget(button)

        self.result = Label(
            text=(
                "Enter a city to view "
                "current weather."
            ),
            font_size=15,
            color=c["secondary"],
            halign="left",
            valign="top"
        )

        self.root_layout.add_widget(
            self.result
        )

        self.root_layout.add_widget(
            Widget()
        )

        self.root_layout.add_widget(
            NButton(
                text="← Home",
                bg=c["card"],
                height=46,
                on_release=lambda x:
                setattr(
                    self.manager,
                    "current",
                    "home"
                )
            )
        )

    def get_weather(self, instance):

        city = self.city.text.strip()

        if not city:

            self.result.text = (
                "Please enter a city."
            )

            return

        self.result.text = (
            "Loading live weather..."
        )

        threading.Thread(
            target=self.fetch_weather,
            args=(city,),
            daemon=True
        ).start()

    def fetch_weather(self, city):

        try:

            r = requests.get(
                "https://geocoding-api.open-meteo.com/v1/search",
                params={
                    "name": city,
                    "count": 1,
                    "language": "en",
                    "format": "json"
                },
                timeout=10
            )

            results = r.json().get(
                "results",
                []
            )

            if not results:

                self.set_result(
                    "City not found."
                )

                return

            place = results[0]

            lat = place["latitude"]
            lon = place["longitude"]

            r = requests.get(
                "https://api.open-meteo.com/v1/forecast",
                params={
                    "latitude": lat,
                    "longitude": lon,
                    "current":
                        "temperature_2m,"
                        "relative_humidity_2m,"
                        "apparent_temperature,"
                        "weather_code,"
                        "wind_speed_10m",
                    "timezone": "auto"
                },
                timeout=10
            )

            current = r.json().get(
                "current",
                {}
            )

            temp = current.get(
                "temperature_2m",
                "?"
            )

            feels = current.get(
                "apparent_temperature",
                "?"
            )

            humidity = current.get(
                "relative_humidity_2m",
                "?"
            )

            wind = current.get(
                "wind_speed_10m",
                "?"
            )

            code = current.get(
                "weather_code",
                -1
            )

            descriptions = {
                0: "Clear sky",
                1: "Mainly clear",
                2: "Partly cloudy",
                3: "Overcast",
                45: "Fog",
                48: "Fog",
                51: "Light drizzle",
                53: "Drizzle",
                55: "Heavy drizzle",
                61: "Light rain",
                63: "Rain",
                65: "Heavy rain",
                71: "Light snow",
                73: "Snow",
                75: "Heavy snow",
                80: "Rain showers",
                81: "Rain showers",
                82: "Heavy rain showers",
                95: "Thunderstorm",
                96: "Thunderstorm",
                99: "Thunderstorm"
            }

            description = descriptions.get(
                code,
                "Weather information"
            )

            text = (
                f"📍 {place.get('name', city)}\n\n"
                f"🌡️ Temperature: {temp}°C\n"
                f"🌡️ Feels like: {feels}°C\n"
                f"💧 Humidity: {humidity}%\n"
                f"💨 Wind: {wind} km/h\n\n"
                f"☁️ {description}"
            )

            self.set_result(text)

            # Optional test notification
            settings = load_notifications()

            if (
                settings["enabled"]
                and settings["weather"]
                and not settings["quiet_mode"]
            ):

                send_notification(
                    "NEXORA Weather",
                    (
                        f"{place.get('name', city)}: "
                        f"{temp}°C, {description}"
                    )
                )

        except Exception as e:

            print(
                "Weather error:",
                e
            )

            self.set_result(
                "Unable to load weather.\n\n"
                "Check your internet connection."
            )

    def set_result(self, text):

        Clock.schedule_once(
            lambda dt:
            setattr(
                self.result,
                "text",
                text
            )
        )


