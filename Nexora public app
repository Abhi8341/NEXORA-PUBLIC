    def set_category(self, category):

        self.category = category

        city = self.city.text.strip()

        if (
            self.lat is not None
            and self.lon is not None
        ):

            self.search_coordinates()

        elif city:

            self.search_city()

        else:

            self.status.text = (
                f"{category}\n"
                "Enter a city or use GPS."
            )

    def search_custom(self, text):

        self.city.text = text
        self.category = "Search Results"

        self.search_city()

    def search_current(self):

        city = self.city.text.strip()

        if not city:

            self.status.text = (
                "Enter a city, area or place."
            )

            return

        if self.category:

            self.search_city()

        else:

            self.search_custom(city)

    def search_city(self):

        city = self.city.text.strip()

        if not city:
            return

        self.status.text = (
            "Finding location..."
        )

        threading.Thread(
            target=self.geocode_city,
            args=(city,),
            daemon=True
        ).start()

    def geocode_city(self, city):

        try:

            response = requests.get(
                "https://nominatim.openstreetmap.org/search",
                params={
                    "q": city,
                    "format": "json",
                    "limit": 1
                },
                headers={
                    "User-Agent":
                    "NEXORA-Public/5.1"
                },
                timeout=15
            )

            data = response.json()

            if not data:

                self.update_status(
                    "Location not found."
                )

                return

            self.lat = float(
                data[0]["lat"]
            )

            self.lon = float(
                data[0]["lon"]
            )

            Clock.schedule_once(
                lambda dt:
                self.search_coordinates()
            )

        except Exception:

            self.update_status(
                "Could not find location."
            )

    def use_gps(self):

        self.status.text = (
            "📍 Getting current location..."
        )

        if not GPS_AVAILABLE:

            self.status.text = (
                "GPS is unavailable.\n"
                "Please enter a city instead."
            )

            return

        try:

            gps.configure(
                on_location=self.on_gps_location,
                on_status=self.on_gps_status
            )

            gps.start(
                minTime=1000,
                minDistance=1
            )

        except Exception:

            self.status.text = (
                "Could not start GPS."
            )

    def on_gps_location(self, **kwargs):

        lat = kwargs.get("lat")
        lon = kwargs.get("lon")

        if lat is None or lon is None:
            return

        self.lat = float(lat)
        self.lon = float(lon)

        try:
            gps.stop()
        except Exception:
            pass

        Clock.schedule_once(
            lambda dt:
            self.location_ready()
        )

    def on_gps_status(self, *args):
        pass

    def location_ready(self):

        self.status.text = (
            "📍 Location ready."
        )

        if self.category:

            self.search_coordinates()

        else:

            self.category = "Hospitals"
            self.search_coordinates()

    def search_coordinates(self):

        if self.lat is None or self.lon is None:

            self.status.text = (
                "Location unavailable."
            )

            return

        self.results.clear_widgets()

        self.status.text = (
            f"Searching {self.category}..."
        )

        threading.Thread(
            target=self.query_overpass,
            args=(
                self.lat,
                self.lon,
                self.category
            ),
            daemon=True
        ).start()

    def get_filter(self, category):

        filters = {
            "Hospitals":
                '["amenity"="hospital"]',
            "Police":
                '["amenity"="police"]',
            "Fire Stations":
                '["amenity"="fire_station"]',
            "Banks":
                '["amenity"="bank"]',
            "Schools":
                '["amenity"="school"]',
            "Government":
                '["office"="government"]',
            "Railway":
                '["railway"="station"]',
            "Bus Stops":
                '["highway"="bus_stop"]',
            "Taxi Stands":
                '["amenity"="taxi"]',
            "Airports":
                '["aeroway"="aerodrome"]',
            "Markets":
                '["shop"="supermarket"]'
        }

        return filters.get(
            category,
            '["name"]'
        )

    def tourist_query(self, lat, lon):

        return f"""
[out:json][timeout:35];

(
 node["tourism"="attraction"]
 (around:20000,{lat},{lon});

 way["tourism"="attraction"]
 (around:20000,{lat},{lon});

 node["tourism"="museum"]
 (around:20000,{lat},{lon});

 way["tourism"="museum"]
 (around:20000,{lat},{lon});

 node["tourism"="viewpoint"]
 (around:20000,{lat},{lon});

 way["tourism"="viewpoint"]
 (around:20000,{lat},{lon});

 node["historic"="monument"]
 (around:20000,{lat},{lon});

 way["historic"="monument"]
 (around:20000,{lat},{lon});

 node["historic"="memorial"]
 (around:20000,{lat},{lon});

 way["historic"="memorial"]
 (around:20000,{lat},{lon});

 node["historic"="castle"]
 (around:20000,{lat},{lon});

 way["historic"="castle"]
 (around:20000,{lat},{lon});

 node["historic"="fort"]
 (around:20000,{lat},{lon});

 way["historic"="fort"]
 (around:20000,{lat},{lon});

 node["leisure"="park"]
 (around:20000,{lat},{lon});

 way["leisure"="park"]
 (around:20000,{lat},{lon});

 node["leisure"="theme_park"]
 (around:20000,{lat},{lon});

 way["leisure"="theme_park"]
 (around:20000,{lat},{lon});
);

out center tags;
"""

    def query_overpass(
        self,
        lat,
        lon,
        category
    ):

        try:

            if category == "Tourist Places":

                query = self.tourist_query(
                    lat,
                    lon
                )

            else:

                filt = self.get_filter(
                    category
                )

                query = f"""
[out:json][timeout:35];

(
 node{filt}
 (around:15000,{lat},{lon});

 way{filt}
 (around:15000,{lat},{lon});

 relation{filt}
 (around:15000,{lat},{lon});
);

out center tags;
"""

            response = requests.post(
                "https://overpass-api.de/api/interpreter",
                data=query,
                headers={
                    "User-Agent":
                    "NEXORA-Public/5.1"
                },
                timeout=50
            )

            elements = response.json().get(
                "elements",
                []
            )

            places = []
            seen = set()

            bad_words = [
                "hotel",
                "hostel",
                "guest house",
                "guesthouse",
                "resort",
                "motel",
                "lodge",
                "homestay"
            ]

            bad_tourism = [
                "hotel",
                "hostel",
                "guest_house",
                "motel",
                "camp_site",
                "chalet",
                "apartment"
            ]

            for element in elements:

                tags = element.get(
                    "tags",
                    {}
                )

                name = (
                    tags.get("name")
                    or tags.get("official_name")
                    or tags.get("alt_name")
                )

                if not name:
                    continue

                if category == "Tourist Places":

                    lower = name.lower()

                    if any(
                        word in lower
                        for word in bad_words
                    ):
                        continue

                    tourism_type = tags.get(
                        "tourism",
                        ""
                    )

                    if tourism_type in bad_tourism:
                        continue

                key = name.lower().strip()

                if key in seen:
                    continue

                seen.add(key)

                place_lat = element.get("lat")
                place_lon = element.get("lon")

                if place_lat is None:

                    center = element.get(
                        "center",
                        {}
                    )

                    place_lat = center.get("lat")
                    place_lon = center.get("lon")

                address_parts = []

                for field in [
                    "addr:housenumber",
                    "addr:street",
                    "addr:suburb",
                    "addr:city",
                    "addr:postcode"
                ]:

                    value = tags.get(field)

                    if value:
                        address_parts.append(value)

                address = ", ".join(
                    address_parts
                )

                description = (
                    tags.get(
                        "description",
                        ""
                    )
                    or tags.get(
                        "operator",
                        ""
                    )
                    or tags.get(
                        "brand",
                        ""
                    )
                )

                places.append({
                    "name": name,
                    "address": address,
                    "description": description,
                    "lat": place_lat,
                    "lon": place_lon
                })

                if len(places) >= 40:
                    break

            Clock.schedule_once(
                lambda dt,
                p=places:
                self.show_results(p)
            )

        except Exception as e:

            print(
                "Overpass error:",
                e
            )

            self.update_status(
                "Unable to load places.\n"
                "Check your internet connection."
            )

    def show_results(self, places):

        self.results.clear_widgets()

        if not places:

            self.status.text = (
                "No suitable places found."
            )

            return

        self.status.text = (
            f"Found {len(places)} places."
        )

        c = C()

        for place in places:

            card = BoxLayout(
                orientation="vertical",
                padding=dp(6),
                spacing=dp(4),
                size_hint_y=None,
                height=dp(145)
            )

            text = (
                "📍 "
                + place["name"]
            )

            if place["address"]:

                text += (
                    "\n"
                    + place["address"]
                )

            if place["description"]:

                text += (
                    "\n"
                    + place["description"]
                )

            card.add_widget(
                Label(
                    text=text,
                    color=c["text"],
                    font_size=11,
                    halign="left"
                )
            )

            row = BoxLayout(
                size_hint_y=None,
                height=dp(40),
                spacing=dp(4)
            )

            maps = NButton(
                text="🗺️ OPEN MAPS",
                bg=c["green"],
                font=9,
                height=38
            )

            maps.bind(
                on_release=lambda x,
                p=place:
                self.open_maps(p)
            )

            save = NButton(
                text="⭐ SAVE",
                bg=c["orange"],
                font=9,
                height=38
            )

            save.bind(
                on_release=lambda x,
                p=place:
                self.save_place(p)
            )

            row.add_widget(maps)
            row.add_widget(save)

            card.add_widget(row)

            self.results.add_widget(card)

    def open_maps(self, place):

        lat = place.get("lat")
        lon = place.get("lon")

        if lat is not None and lon is not None:

            url = (
                "https://www.google.com/maps/"
                "search/?api=1&query="
                f"{lat},{lon}"
            )

        else:

            query = place["name"]

            if place["address"]:

                query += (
                    " "
                    + place["address"]
                )

            url = (
                "https://www.google.com/maps/"
                "search/?api=1&query="
                + quote(query)
            )

        webbrowser.open(url)

    def save_place(self, place):

        favorites = load_favorites()

        if any(
            item.get("name")
            == place["name"]
            for item in favorites
        ):

            self.status.text = (
                "⭐ Already saved."
            )

            return

        favorites.append({
            "name": place["name"],
            "address": place["address"],
            "description":
                place["description"],
            "latitude":
                place["lat"],
            "longitude":
                place["lon"]
        })

        save_favorites(favorites)

        self.status.text = (
            "⭐ Place saved."
        )

    def update_status(self, text):

        Clock.schedule_once(
            lambda dt:
            setattr(
                self.status,
                "text",
                text
            )
        )


